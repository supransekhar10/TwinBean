FIREBASE_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\firebase-service-account.json
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ORIGIN_REGEX=^http://(?:localhost|127\.0\.0\.1|192\.168(?:\.\d{1,3}){2}):300[01]$
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Server-controlled direct child of backend/model_artifacts; never accept this from requests.
AKI_MODEL_RELEASE=aki-24h-2026.10.08b
# Positive cap for synchronous XGBoost and SHAP work offloaded from the API event loop.
AKI_INFERENCE_CONCURRENCY=2
